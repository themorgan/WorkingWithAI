# Install as .github/workflows/bestpractice-upstream-sync.yml in a repo
# carrying the personal pack. Scheduled, unattended equivalent of
# BestPractice's own INSTALL.md §2 ("Take an upstream update"): checks
# whether the public BestPractice repo has moved past
# process/manifest.json's recorded commit, and if so, takes the update,
# integrates it using its own judgment, and merges it to the default
# branch — without waiting for a session to notice.
#
# `check` costs one `git ls-remote` and never calls the model, so a quiet
# run costs nothing. `update` only runs when upstream actually moved.
#
# `check` also verifies a Claude credential is configured — either
# CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY satisfies it, since `update`
# calls Claude Code and can't run without one. If upstream moved but
# neither secret is set, `update` is skipped (rather than attempted and
# failing on an auth error) and `note-missing-credential` leaves a clear
# `::warning::` in the run's summary instead. A chat session asked to run
# this sync manually doesn't need either secret at all — it can just take
# the update itself, in-session, following process/upstream/INSTALL.md §2
# — but should still remind Morgan to set one so future unattended runs
# don't need to be asked for.
#
# Frequency defaults to weekly; switching to daily is a one-line swap.
# Cron is UTC-only, so both lines below convert from Buenos Aires local
# time (America/Argentina/Buenos_Aires, UTC-3 year-round, no DST since
# 2009 — verified 2026-08-21) by adding 3 hours. To change frequency,
# comment out the active `- cron:` line and uncomment the other one; to
# change time of day, adjust either line's hour/minute the same way.
name: BestPractice sync

on:
  schedule:
    # Weekly (default): every Monday at 09:00 Buenos Aires.
    - cron: '0 12 * * 1'
    # Daily: uncomment this line and comment out the weekly one above.
    # - cron: '0 12 * * *'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  check:
    name: Check upstream
    runs-on: ubuntu-latest
    outputs:
      moved: ${{ steps.check.outputs.moved }}
      credential_set: ${{ steps.credential-check.outputs.credential_set }}
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Check whether a Claude credential is set
        id: credential-check
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
          CLAUDE_CODE_OAUTH_TOKEN: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
        run: |
          if [ -n "${ANTHROPIC_API_KEY:-}" ] || [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
            echo "credential_set=true" >> "$GITHUB_OUTPUT"
          else
            echo "credential_set=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Compare recorded commit against upstream HEAD
        id: check
        run: |
          set -euo pipefail
          REPO=$(python3 -c "import json;print(json.load(open('process/manifest.json'))['upstream']['repo'])")
          RECORDED=$(python3 -c "import json;print(json.load(open('process/manifest.json'))['upstream']['commit'])")
          HEAD=$(git ls-remote "$REPO" HEAD | cut -f1)
          echo "recorded=$RECORDED  head=$HEAD"
          if [ -n "$HEAD" ] && [ "$HEAD" != "$RECORDED" ]; then
            echo "moved=true" >> "$GITHUB_OUTPUT"
          else
            echo "moved=false" >> "$GITHUB_OUTPUT"
          fi

  note-missing-credential:
    name: Note skipped run (no Claude credential set)
    needs: check
    if: needs.check.outputs.moved == 'true' && needs.check.outputs.credential_set == 'false'
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Explain why this run did nothing
        run: |
          {
            echo "BestPractice has moved upstream, but neither \`CLAUDE_CODE_OAUTH_TOKEN\` nor \`ANTHROPIC_API_KEY\` is set, so this sync could not take the update automatically this time."
            echo ""
            echo "Set one of the two secrets at **Settings -> Secrets and variables -> Actions -> New repository secret** so future runs can take the update unattended (see GETTING_STARTED.md's administrator section), or ask a chat session to take this update manually in the meantime."
          } | tee -a "$GITHUB_STEP_SUMMARY"
          echo "::warning::BestPractice sync skipped: neither CLAUDE_CODE_OAUTH_TOKEN nor ANTHROPIC_API_KEY is set."

  update:
    name: Take the update, integrate, PR, merge
    needs: check
    if: needs.check.outputs.moved == 'true' && needs.check.outputs.credential_set == 'true'
    runs-on: ubuntu-latest
    permissions:
      contents: write
      pull-requests: write

    steps:
      - name: Check out repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install check dependencies
        run: python -m pip install cmarkgfm pyyaml

      - name: Run Claude Code to take the update
        uses: anthropics/claude-code-action@v1
        with:
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}
          prompt: |
            BestPractice (the public upstream repo recorded in
            process/manifest.json) has moved since this repo's vendored copy
            was last synced. Take the update, unattended, following
            process/upstream/INSTALL.md §2 exactly:

            1. Clone the upstream repo (process/manifest.json upstream.repo)
               to a scratch directory. Diff its default branch against the
               vendored tree at process/upstream/, at the recorded base
               commit (process/manifest.json upstream.commit).
            2. For every process/manifest.json entry, three-way-merge: old
               upstream vs new upstream vs this repo's installed, adapted
               copy at local_path. Apply upstream's changes through the
               adaptation recorded in each entry's "notes" — never clobber a
               local adaptation, including anything under process/personal/
               (that layer is not part of BestPractice and upstream will
               never mention it, so it should never be touched by this
               process).
            3. Instantiate anything the recorded install predates (INSTALL.md
               §2 step 3) and fix any legacy layout issue (§2 step 4).
            4. Replace process/upstream/ with the new tree
               (process/upstream/tools/checkin.py update <clone>), update
               upstream.commit (checkin.py record <clone>), and run
               process/upstream/tools/practice_audit.py --update-baseline.
            5. Run the repo's gates and make sure they all pass before
               committing anything:
               python3 process/upstream/tools/doc_lint.py --all
               python3 process/personal/tools/light_check.py --all
               python3 process/upstream/tools/practice_audit.py

            Judgment calls you make while merging (a conflict between an
            upstream change and a local adaptation, a template change that
            doesn't map cleanly onto this repo, anything you resolved one way
            rather than another) are exactly what a human should skim before
            trusting an unattended merge. List every one of them, plainly, in
            the commit message body — not just the PR description — under a
            "Judgment calls to review:" heading. If there are none, say so
            explicitly rather than omitting the heading.

            Commit as author "Morgan F <morgan@westegg.com>" (reuse the
            address already used by prior commits in this repo's history —
            do not guess a different one). Add yourself as Co-Authored-By.
            Add a trailer
            `Session: <this workflow run's URL>` — build it from
            `$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID`
            — since there is no chat session behind an unattended run, and
            that run is the closest equivalent record of where this change
            was "planned".

            Push a branch, open a pull request against the default branch
            summarizing what upstream changed and restating the judgment
            calls from the commit message, wait for this repo's own checks
            (Markdown lint, light check, practice_audit) to report success on
            the PR, then merge it. If any check fails and you cannot fix it
            confidently, leave the PR open, unmerged, with a comment
            explaining exactly what failed and why you stopped — do not force
            a merge past a failing check.
