{
  "_comment": "Claude Code adapter (practice 13). Wires the SessionStart hooks (tools/bootstrap.sh, then the precedent-individual bootstrap -- see process/PRECEDENT_MIGRATION.md), a Stop hook that blocks ending a turn with uncommitted/untracked/unpushed work, and allowlists the routine safe commands sessions run constantly so work doesn't stall on permission prompts.",
  "permissions": {
    "allow": [
      "Bash(grep *)",
      "Bash(git fetch *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin *)",
      "Bash(git check-ignore *)",
      "Bash(git check-attr *)",
      "Bash(python3 process/upstream/tools/doc_lint.py *)",
      "Bash(python3 process/upstream/tools/practice_audit.py)",
      "Bash(python3 process/upstream/tools/practice_audit.py *)",
      "Bash(python3 process/upstream/tools/checkin.py *)",
      "Bash(python3 process/upstream/tools/precedent_resolve.py *)",
      "Bash(python3 process/upstream/tools/precedent_check.py *)",
      "Bash(python3 tools/light_check.py *)",
      "Bash(python3 tools/report_automation_issue.py *)",
      "Bash(python3 process/voice/tools/voice_sync.py *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/precedent-individual-bootstrap.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop-git-check.sh"
          }
        ]
      }
    ]
  }
}
